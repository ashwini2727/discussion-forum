# Application Port
PORT=3000

# Session Secret (change this to a secure random string)
SESSION_SECRET=change_this_to_a_secure_random_key

# -------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------
# By default, the application runs with zero configuration
# using a local SQLite database (data/forum.sqlite).
#
# If you want to use MySQL instead, uncomment and fill in:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=forum_db
# -------------------------------------------------------------
